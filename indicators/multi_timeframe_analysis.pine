//@version=6
indicator("Multi Timeframe Analysis & Setup Engine", shorttitle="MTF Setup Engine v6", overlay=true)

// ==========================================
// 1. INPUT PARAMETERS & GROUPS
// ==========================================

// --- Group: Macro Higher Timeframe (4H / Daily) Settings ---
gp_htf1 = "1. Macro Higher Timeframe (Macro HTF)"
htf1Timeframe   = input.timeframe("240", "Macro HTF Timeframe", group=gp_htf1, tooltip="Primary HTF for ADX and Trend Direction analysis (e.g. 240 for 4H, D for Daily).")
adxLength       = input.int(14, "ADX / DMI Length", minval=1, group=gp_htf1)
adxSmoothing    = input.int(14, "ADX Smoothing", minval=1, group=gp_htf1)
adxThreshold    = input.int(25, "ADX Trend Strength Threshold", minval=1, group=gp_htf1, tooltip="ADX above this level indicates a strong trend.")
useHtf1EmaFilter= input.bool(true, "Use Macro HTF EMA Filter", group=gp_htf1, tooltip="Require price to be above/below Macro HTF 200 EMA.")
htf1EmaLength   = input.int(200, "Macro HTF EMA Length", minval=1, group=gp_htf1)

// --- Group: Intermediate Timeframe (1H) Alignment Settings ---
gp_itf = "2. Intermediate Timeframe (1H Alignment)"
useItfFilter    = input.bool(true, "Require Intermediate HTF Alignment", group=gp_itf, tooltip="Require 1H trend alignment to prevent counter-trend entries into 1H pullbacks.")
itfTimeframe    = input.timeframe("60", "Intermediate Timeframe (ITF)", group=gp_itf)
itfEmaLength    = input.int(50, "ITF EMA Length", minval=1, group=gp_itf)

// --- Group: Lower Timeframe (LTF) Execution & Filters ---
gp_ltf = "3. Execution & LTF Confluence Filters"
stochKLength    = input.int(14, "%K Length", minval=1, group=gp_ltf)
stochKSmooth    = input.int(3, "%K Smoothing", minval=1, group=gp_ltf)
stochDSmooth    = input.int(3, "%D Smoothing", minval=1, group=gp_ltf)
stochOversold   = input.float(20.0, "Oversold Threshold (Buy Zone)", minval=0.0, maxval=50.0, group=gp_ltf)
stochOverbought = input.float(80.0, "Overbought Threshold (Sell Zone)", minval=50.0, maxval=100.0, group=gp_ltf)

useLtfEmaFilter = input.bool(true, "Require Price > LTF EMA for Longs", group=gp_ltf, tooltip="Filters out falling knives by ensuring price is above the LTF fast EMA.")
ltfEmaLength    = input.int(20, "LTF EMA Length", minval=1, group=gp_ltf)

useRsiFilter    = input.bool(true, "Require LTF RSI Momentum Confirmation", group=gp_ltf)
rsiLength       = input.int(14, "RSI Length", minval=1, group=gp_ltf)
rsiMinBull      = input.float(45.0, "Min RSI for Long Setup", minval=0.0, maxval=100.0, group=gp_ltf)
rsiMaxBear      = input.float(55.0, "Max RSI for Short Setup", minval=0.0, maxval=100.0, group=gp_ltf)

useCandleFilter = input.bool(true, "Require Reversal Candle Pattern", group=gp_ltf, tooltip="Require a green reversal candle (Close > Open and Close > High[1]) on Long entries.")

// --- Group: Visual & Plot Settings ---
gp_vis = "Visuals & Chart Plotting"
showTable       = input.bool(true, "Show MTF Dashboard Table", group=gp_vis)
tablePosition   = input.string("Top Right", "Table Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=gp_vis)
showHtfEma      = input.bool(true, "Plot Macro HTF EMA on Chart", group=gp_vis)
showLtfEma      = input.bool(true, "Plot LTF 20 EMA on Chart", group=gp_vis)
showSignals     = input.bool(true, "Plot Buy/Sell Signals on Chart", group=gp_vis)
showBgColor     = input.bool(true, "Highlight Chart BG on Strong HTF Trend", group=gp_vis)

// --- Group: Colors ---
gp_col = "Color Theme"
colorBull       = input.color(color.new(#089981, 0), "Bullish Color", group=gp_col)
colorBear       = input.color(color.new(#f23645, 0), "Bearish Color", group=gp_col)
colorNeutral    = input.color(color.new(#787b86, 0), "Neutral Color", group=gp_col)

// ==========================================
// 2. HIGHER TIMEFRAME (HTF) DATA CALCULATIONS
// ==========================================

// Function to calculate Macro HTF indicators
f_htf1_calc() =>
    [plus_di, minus_di, adx] = ta.dmi(adxLength, adxSmoothing)
    ema_val = ta.ema(close, htf1EmaLength)
    [adx, plus_di, minus_di, ema_val, close]

// Fetch non-repainting Macro HTF data
[htf1_adx, htf1_plus_di, htf1_minus_di, htf1_ema, htf1_close] = request.security(
     syminfo.tickerid, 
     htf1Timeframe, 
     f_htf1_calc(), 
     gaps = barmerge.gaps_off, 
     lookahead = barmerge.lookahead_off
 )

// Function to calculate Intermediate HTF indicators
f_itf_calc() =>
    [plus_di, minus_di, adx] = ta.dmi(adxLength, adxSmoothing)
    ema_val = ta.ema(close, itfEmaLength)
    [plus_di, minus_di, ema_val, close]

// Fetch non-repainting Intermediate HTF data
[itf_plus_di, itf_minus_di, itf_ema, itf_close] = request.security(
     syminfo.tickerid, 
     itfTimeframe, 
     f_itf_calc(), 
     gaps = barmerge.gaps_off, 
     lookahead = barmerge.lookahead_off
 )

// Macro HTF Trend Evaluators
isHtf1StrongTrend = htf1_adx >= adxThreshold
isHtf1Bullish     = isHtf1StrongTrend and (htf1_plus_di > htf1_minus_di) and (not useHtf1EmaFilter or htf1_close > htf1_ema)
isHtf1Bearish     = isHtf1StrongTrend and (htf1_minus_di > htf1_plus_di) and (not useHtf1EmaFilter or htf1_close < htf1_ema)

// Intermediate HTF Evaluators
isItfBullish     = not useItfFilter or ((itf_plus_di >= itf_minus_di) and (itf_close > itf_ema))
isItfBearish     = not useItfFilter or ((itf_minus_di >= itf_plus_di) and (itf_close < itf_ema))

// ==========================================
// 3. EXECUTION / LTF STOCHASTIC & CONFLUENCE
// ==========================================

stoch_raw = ta.stoch(close, high, low, stochKLength)
stoch_k   = ta.sma(stoch_raw, stochKSmooth)
stoch_d   = ta.sma(stoch_k, stochDSmooth)

ltfEma = ta.ema(close, ltfEmaLength)
ltfRsi = ta.rsi(close, rsiLength)

// LTF Triggers & Filters
isStochOversold   = stoch_k <= stochOversold
isStochOverbought = stoch_k >= stochOverbought

stochBullCross = ta.crossover(stoch_k, stoch_d) and (stoch_k <= stochOversold or stoch_k[1] <= stochOversold)
stochBearCross = ta.crossunder(stoch_k, stoch_d) and (stoch_k >= stochOverbought or stoch_k[1] >= stochOverbought)

isLtfEmaBull = not useLtfEmaFilter or (close > ltfEma)
isLtfEmaBear = not useLtfEmaFilter or (close < ltfEma)

isLtfRsiBull = not useRsiFilter or (ltfRsi >= rsiMinBull)
isLtfRsiBear = not useRsiFilter or (ltfRsi <= rsiMaxBear)

isBullCandle = not useCandleFilter or (close > open and close > high[1])
isBearCandle = not useCandleFilter or (close < open and close < low[1])

// ==========================================
// 4. CONFLUENCE ENTRY SETUP LOGIC
// ==========================================

longSetup  = isHtf1Bullish and isItfBullish and stochBullCross and isLtfEmaBull and isLtfRsiBull and isBullCandle
shortSetup = isHtf1Bearish and isItfBearish and stochBearCross and isLtfEmaBear and isLtfRsiBear and isBearCandle

// ==========================================
// 5. CHART PLOTTING & VISUALS
// ==========================================

// Always-present Unconditional Plot Anchor (Ensures Pine Script Compiler CE10246 Output Requirement)
plot(close, title="Indicator Anchor", display=display.none)

// Plot Moving Averages
plot(showHtfEma ? htf1_ema : na, title="Macro HTF Trend EMA", color=color.new(#2962ff, 0), linewidth=2)
plot(showLtfEma ? ltfEma : na, title="LTF Fast EMA", color=color.new(#ff9800, 0), linewidth=1)

// Plot Setup Signals
plotshape(showSignals and longSetup, title="Long Entry Signal", style=shape.triangleup, location=location.belowbar, color=colorBull, size=size.small, text="BUY")
plotshape(showSignals and shortSetup, title="Short Entry Signal", style=shape.triangledown, location=location.abovebar, color=colorBear, size=size.small, text="SELL")

// Background Tint for Strong Trend Alignment
bgcolor(showBgColor and isHtf1Bullish and isItfBullish ? color.new(colorBull, 90) : showBgColor and isHtf1Bearish and isItfBearish ? color.new(colorBear, 90) : na, title="Trend BG Highlight")

// ==========================================
// 6. DASHBOARD MATRIX TABLE (PINE SCRIPT V6)
// ==========================================

f_getTablePosition(string pos) =>
    switch pos
        "Top Right"    => position.top_right
        "Bottom Right" => position.bottom_right
        "Top Left"     => position.top_left
        "Bottom Left"  => position.bottom_left
        => position.top_right

var table mtfTable = table.new(f_getTablePosition(tablePosition), 2, 7, bgcolor=color.new(#1e222d, 10), border_width=1, border_color=color.new(#363a45, 0))

if showTable and barstate.islast
    // Header
    table.cell(mtfTable, 0, 0, "MTF Confluence Matrix", bgcolor=color.new(#2a2e39, 0), text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 0, "Status / Filter", bgcolor=color.new(#2a2e39, 0), text_color=color.white, text_size=size.small)
    
    // Row 1: Macro HTF ADX (4H)
    string adxText = str.tostring(htf1_adx, "#.#") + (isHtf1StrongTrend ? " (Strong)" : " (Weak)")
    color adxBgColor = isHtf1StrongTrend ? color.new(#ff9800, 20) : color.new(colorNeutral, 50)
    table.cell(mtfTable, 0, 1, "Macro HTF ADX (" + htf1Timeframe + ")", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 1, adxText, bgcolor=adxBgColor, text_color=color.white, text_size=size.small)

    // Row 2: Macro HTF Direction (4H)
    string htf1DirText = htf1_plus_di > htf1_minus_di ? "Bullish (+DI > -DI)" : "Bearish (-DI > +DI)"
    color htf1DirBg = htf1_plus_di > htf1_minus_di ? color.new(colorBull, 30) : color.new(colorBear, 30)
    table.cell(mtfTable, 0, 2, "Macro HTF Bias (" + htf1Timeframe + ")", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 2, htf1DirText, bgcolor=htf1DirBg, text_color=color.white, text_size=size.small)

    // Row 3: Intermediate HTF Alignment (1H)
    string itfText = isItfBullish ? "Bullish Alignment" : isItfBearish ? "Bearish Alignment" : "Counter-Trend / Off"
    color itfBgColor = isItfBullish ? color.new(colorBull, 40) : isItfBearish ? color.new(colorBear, 40) : color.new(colorNeutral, 60)
    table.cell(mtfTable, 0, 3, "Intermed HTF (" + itfTimeframe + ")", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 3, itfText, bgcolor=itfBgColor, text_color=color.white, text_size=size.small)

    // Row 4: LTF Stoch %K / %D
    string stochText = str.tostring(stoch_k, "#.#") + " / " + str.tostring(stoch_d, "#.#") + (isStochOversold ? " (Oversold)" : isStochOverbought ? " (Overbought)" : " (Neutral)")
    color stochBgColor = isStochOversold ? color.new(colorBull, 40) : isStochOverbought ? color.new(colorBear, 40) : color.new(colorNeutral, 70)
    table.cell(mtfTable, 0, 4, "LTF Stoch (%K/%D)", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 4, stochText, bgcolor=stochBgColor, text_color=color.white, text_size=size.small)

    // Row 5: LTF Filters (EMA & RSI)
    string ltfFilterText = (isLtfEmaBull and isLtfRsiBull ? "Bullish PASS" : isLtfEmaBear and isLtfRsiBear ? "Bearish PASS" : "WAITING CONFIRMATION")
    color ltfFilterBg = (isLtfEmaBull and isLtfRsiBull ? color.new(colorBull, 40) : isLtfEmaBear and isLtfRsiBear ? color.new(colorBear, 40) : color.new(colorNeutral, 60))
    table.cell(mtfTable, 0, 5, "LTF EMA & RSI Filter", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 5, ltfFilterText, bgcolor=ltfFilterBg, text_color=color.white, text_size=size.small)

    // Row 6: Overall Setup State
    string setupText = longSetup ? "🟢 LONG SETUP READY" : shortSetup ? "🔴 SHORT SETUP READY" : (isHtf1Bullish and isItfBullish) ? "WAITING FOR PULLBACK" : (isHtf1Bearish and isItfBearish) ? "WAITING FOR BOUNCE" : "NO TREND CONFLUENCE"
    color setupBgColor = longSetup ? colorBull : shortSetup ? colorBear : color.new(#2a2e39, 0)
    table.cell(mtfTable, 0, 6, "Overall Setup State", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 6, setupText, bgcolor=setupBgColor, text_color=color.white, text_size=size.small)

// ==========================================
// 7. ALERT ENGINE
// ==========================================

alertcondition(longSetup, title="MTF Long Setup Triggered", message="🟢 MTF LONG SETUP: 4H+1H Bullish Confluence with LTF Stochastic Oversold Crossover & Reversal Candle on {{ticker}} at {{close}}")
alertcondition(shortSetup, title="MTF Short Setup Triggered", message="🔴 MTF SHORT SETUP: 4H+1H Bearish Confluence with LTF Stochastic Overbought Crossunder & Reversal Candle on {{ticker}} at {{close}}")

if longSetup
    alert('{"event": "LONG_SETUP", "ticker": "' + syminfo.ticker + '", "price": ' + str.tostring(close) + ', "htf_adx": ' + str.tostring(htf1_adx) + ', "stoch_k": ' + str.tostring(stoch_k) + '}', alert.freq_once_per_bar_close)

if shortSetup
    alert('{"event": "SHORT_SETUP", "ticker": "' + syminfo.ticker + '", "price": ' + str.tostring(close) + ', "htf_adx": ' + str.tostring(htf1_adx) + ', "stoch_k": ' + str.tostring(stoch_k) + '}', alert.freq_once_per_bar_close)
